{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 tests/lint_prompts.py)",
      "Bash(python3 tests/run_eval.py --dry-run)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Edit(prompts/ko/**)",
      "Edit(prompts/en/**)",
      "Write(prompts/ko/**)",
      "Write(prompts/en/**)"
    ]
  }
}
